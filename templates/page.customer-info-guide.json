        "collapsible_row_cGVitg": {
          "type": "collapsible_row",
          "settings": {
            "heading": "RETURNS AND REFUNDS",
            "anchor_id": "",
            "icon": "none",
            "row_content": "<p><strong><br/>TO REQUEST A RETURN </strong><a href=\"mailto:info@lloydsteven.com\" title=\"mailto:info@lloydsteven.com\"><strong>PLEASE CONTACT THE STUDIO </strong></a></p><p><strong><br/>CHANGE OF MIND RETURNS<br/></strong>- Returns for in stock items are accepted within 14 days of delivery for a full refund.<br/>- Items must be unworn, in original packaging, and accompanied by proof of purchase.<br/>- Returns can be shipped to our USA or Australian return address at the buyer's expense.<br/>- Custom orders and altered pieces are exempt from unless faulty.<br/>- Please email us prior to making a purchase if you have any questions about the eligibility of a return.<br/><br/><strong><br/>FAULTY ITEMS UPON DELIVERY<br/></strong><em>- </em>Covered under <strong>Australian Consumer Law</strong> (ACL): entitled to repair, replacement, or refund if faulty, damaged, or not as described.<br/>- If your item is faulty, contact support with your order number and photos.</p>",
            "page": ""
          }
