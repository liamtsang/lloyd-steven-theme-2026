{"sections":{"shogun-helper":{"type":"shogun-helper","settings":{}},"main":{"type":"main-page","disabled":true,"settings":{"padding_top":28,"padding_bottom":28}},"shogun-optimizer":{"type":"shogun-optimizer","settings":{}},"rich_text_bYm7BH":{"type":"rich-text","blocks":{"heading_eX7cqY":{"type":"heading","settings":{"heading":"<p>CUSTOMS AND CONCIERGE<\/p>","heading_size":"h2"}},"text_GakFTT":{"type":"text","settings":{"text":"<p>Custom engagement rings, personal jewelry and objects.<\/p><p>Each commission is guided end to end, from initial consultation to final delivery and follows a defined design process, with a limited number accepted each month.<\/p><p><br\/><br\/><a href=\"mailto:info@lloydsteven.com\" title=\"mailto:info@lloydsteven.com\"><strong>REQUEST AN APPOINTMENT<\/strong><\/a><\/p>"}}},"block_order":["heading_eX7cqY","text_GakFTT"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"multirow_9fJdVY":{"type":"multirow","blocks":{"row_XJfEE6":{"type":"row","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-12-18_at_11.01.07_am.png","caption":"","heading":"","text":"<h2>STEP ONE : CONSULTATION<br\/><\/h2><p><br\/>In person or virtually. We’ll review references, preferences, and parameters, then define a clear design brief. Guidance is provided on design, materials, and stone selection, with curated options for diamonds and gemstones sourced specifically for each commission.<\/p><p>Consultations typically run 30-45 mins.<\/p><p>*Timelines are confirmed prior to production.<br\/>*No obligation to proceed.<\/p>","button_label":"","button_link":""}},"row_PBefte":{"type":"row","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-12-18_at_11.00.35_am_a9931c2c-cded-4453-b85e-f03e09db4ea3.png","caption":"","heading":"","text":"<h2>STEP TWO : DESIGN VISUALIZATION<\/h2><p><br\/>Your concept is translated into detailed CAD renderings, shared from all angles. We refine proportions and details are refined to resolution before production.<br\/><br\/>*High-fidelity 3D visualisation<br\/>*Designs are refined to resolution before production.<br\/>*A 50% deposit is taken once the design is approved.<\/p>","button_label":"","button_link":""}},"row_yRtciC":{"type":"row","settings":{"image":"shopify:\/\/shop_images\/N6A4769_fd71465d-1ac3-41cc-947f-0b5274db7f50.jpg","caption":"","heading":"","text":"<h2>STEP THREE : CRAFT<\/h2><p><br\/>Following approval, production begins. All technical decisions are handled in-studio and your custom design is handmade by Master Craftspeople in Sydney, Australia. Each piece is made with long-term wear, structure, and future resizing in mind. <\/p><p>*Ready in 4-8 weeks depending on design complexity and stone sourcing, expedited timelines are not offered.<br\/>*GIA IFI Certification included where applicable.<\/p>","button_label":"","button_link":""}}},"block_order":["row_XJfEE6","row_PBefte","row_yRtciC"],"name":"t:sections.multirow.presets.name","settings":{"image_height":"adapt","desktop_image_width":"medium","heading_size":"h2","text_style":"body","button_style":"secondary","desktop_content_position":"middle","desktop_content_alignment":"left","image_layout":"align-left","section_color_scheme":"","row_color_scheme":"","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"multirow_4qXczU":{"type":"multirow","blocks":{"row_nrYAyF":{"type":"row","settings":{"image":"shopify:\/\/shop_images\/N6A7227.jpg","caption":"","heading":"","text":"<h2>STEP FOUR : COMPLETION & DELIVERY<\/h2><p><br\/>Once complete, we share detailed imagery and video for your review. The final balance is confirmed only once the piece is approved.<\/p><p>*Remaining 50% balance due upon completion.<br\/>*Secure, insured DHL worldwide shipping is included.<br\/>*Ongoing care and support and complimentary first resize, if required.<\/p>","button_label":"