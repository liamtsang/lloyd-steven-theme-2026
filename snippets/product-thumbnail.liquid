{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{% comment %}
  Renders a product thumbnail with instant autoplay (no deferred media)

  Accepts:
  - media: {Object} Product Media object
  - position: {String}
  - loop: {Boolean}
  - modal_id: {String}
  - xr_button: {Boolean}
  - media_width: {Float}
  - lazy_load: {Boolean}
{% endcomment %}

<noscript>
  <div class="product__media media gradient global-media-settings">
    <img
      src="{{ media | image_url: width: 1946 }}"
      alt="{{ media.preview_image.alt | escape }}"
      loading="lazy"
      width=""
      height="{{ 973 | divided_by: media.preview_image.aspect_ratio | ceil }}"
    >
  </div>
</noscript>

<div
  class="product__modal-opener product__modal-opener--{{ media.media_type }} no-js-hidden"
  data-modal="#ProductModal-{{ modal_id }}"
>

  {% case media.media_type %}

    {% when 'image' %}

      <div class="product__media media media--transparent gradient global-media-settings">
        <img
          src="{{ media | image_url: width: 1946 }}"
          alt="{{ media.alt | escape }}"
          {% unless lazy_load == false %}
            loading="lazy"
          {% endunless %}
          width=""
          height="{{ 973 | divided_by: media.preview_image.aspect_ratio | ceil }}"
        >
      </div>


    {% when 'video' %}

      <div class="product__media media media--transparent gradient global-media-settings">
        {{ media | media_tag:
          image_size: '2048x',
          autoplay: true,
          loop: loop,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'auto'
        }}
      </div>


    {% when 'external_video' %}

      <div class="product__media media media--transparent gradient global-media-settings">
        {% if media.host == 'youtube' %}
          {{ media
            | external_video_url: autoplay: true, loop: true, playlist: media.external_id
            | external_video_tag:
              loading: 'lazy'
          }}
        {% else %}
          {{ media
            | external_video_url: autoplay: true, loop: true
            | external_video_tag:
              loading: 'lazy'
          }}
        {% endif %}
      </div>


    {% when 'model' %}

      <product-model
        class="media media--transparent gradient global-media-settings product__media"
        data-media-id="{{ media.id }}"
      >
        {{ media | media_tag: image_size: '2048x', toggleable: true }}
      </product-model>

      {% if xr_button %}
        <button
          class="button button--full-width product__xr-button"
          type="button"
          aria-label="{{ 'products.product.xr_button_label' | t }}"
          data-shopify-xr
          data-shopify-model3d-id="{{ media.id }}"
          data-shopify-title="title"
          data-shopify-xr-hidden
        >
          {% render 'icon-3d-model' %}
          {{ 'products.product.xr_button' | t }}
        </button>
      {% endif %}

  {% endcase %}

</div>
