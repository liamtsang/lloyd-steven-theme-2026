<div id="popup" class="popup" style="display: none;">
  <div class="popup-content">
    <span class="close-popup" onclick="closePopup()">&times;</span>
    <div class="popup-image">
      <img src="https://cdn.shopify.com/s/files/1/0619/3250/3240/files/ALI_ORB_FRONT_4.png?v=1727066249" alt="Popup Image">
    </div>
    <div class="popup-text">
      <h2>Alphabets</h2>
      <p>Pendants A to Z.</p>
       <p>Ready to ship.</p>
      <p>Now Available.</p>
      <button class="popup-button">SHOP NOW</button>
    </div>
  </div>
</div>

  <style>
/* Popup overlay */
.popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8); /* Dimmed background */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

/* Popup content */
.popup-content {
  position: relative;
  background-color: #fff;
  padding: 20px;
  max-width: 500px;
  width: 80%;
  text-align: center;
  border-radius: 10px;
}

/* Close button */
.close-popup {
  position: absolute;
  top: 10px;
  right: 20px;
  font-size: 30px;
  cursor: pointer;
}

/* Image styling */
.popup-image img {
  width: 100%;
  border-radius: 10px;
}

/* Popup text styling */
.popup-text {
  margin-top: 20px;
}

.popup-text h2 {
  font-family: 'YourCustomFont', sans-serif;
  font-size: 28px;
  margin-bottom: 10px;
}

.popup-text p {
  font-size: 16px;
  margin-bottom: 20px;
}

.popup-button {
  background-color: #f00; /* Customize this to match your design */
  color: #fff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  font-size: 16px;
  border-radius: 5px;
}

  </style>
