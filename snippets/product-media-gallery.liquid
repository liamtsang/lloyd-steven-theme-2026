<div class="custom-product-layout">

  <!-- LEFT: thumbnails -->
  <div class="custom-thumbnails">
    {%- for image in product.images -%}
      <div class="custom-thumb" data-index="{{ forloop.index0 }}">
        <img src="{{ image | img_url: '100x' }}">
      </div>
    {%- endfor -%}
  </div>

  <!-- RIGHT: your EXISTING slider (UNCHANGED) -->
  <div class="custom-main">
    <div class="slider">
      {%- for image in product.images -%}
        {%- assign color = null -%}
        {%- for variant in product.variants -%}
          {%- if variant.featured_image.src == image.src -%}
            {%- for option in product.options_with_values -%}
              {% if option.name == 'CHOOSE METAL'
                or option.name == 'Color'
                or option.name == 'COLOR'
                or option.name == 'METAL'
                or option.name == 'Metal'
              %}
                {%- assign color_index = forloop.index0 -%}
                {%- assign color = variant.options[color_index] -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="slider-item">
          <img
            src="{{ image | img_url: 'master' }}"
            alt="{{ image.alt | escape }}"
            data-index="{{ forloop.index0 }}"
            data-color="{{ color | escape }}"
          >
        </div>
      {%- endfor -%}

      <div class="slider-controls">
        <!-- buttons unchanged -->
      </div>
    </div>
  </div>

</div>