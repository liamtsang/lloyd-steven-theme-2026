{% comment %}
  Custom Dual Collection/Product Showcase
  Save as:
  sections/custom-dual-showcase.liquid
{% endcomment %}

<section class="custom-dual-showcase">
  <div class="custom-dual-showcase__grid page-width">

    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link }}"
        class="custom-dual-showcase__item"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.image != blank %}
          <div class="custom-dual-showcase__image-wrapper">
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'custom-dual-showcase__image',
                alt: block.settings.title
            }}
          </div>
        {% endif %}

        {% if block.settings.title != blank %}
          <div class="custom-dual-showcase__cta-wrapper">
            <span class="custom-dual-showcase__cta">
              {{ block.settings.title }}
            </span>
          </div>
        {% endif %}

      </a>
    {% endfor %}

  </div>
</section>

<style>
.custom-dual-showcase {
  width: 100%;
  padding: 0;
}

.custom-dual-showcase .page-width {
  max-width: 100%;
  padding-left: 30px;
  padding-right: 30px;
}

.custom-dual-showcase__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
}

.custom-dual-showcase__item {
  display: block;
  text-decoration: none;
  color: inherit;
}

.custom-dual-showcase__image-wrapper {
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
  aspect-ratio: 600 / 800;
}

.custom-dual-showcase__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .5s ease;
}

.custom-dual-showcase__item:hover .custom-dual-showcase__image {
  transform: scale(1.02);
}

.custom-dual-showcase__cta-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 18px;
}

.custom-dual-showcase__cta {
  position: relative;
  display: inline-block;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: {{ section.settings.text_color }};
  line-height: 1.3;
  padding-bottom: 6px;
}

.custom-dual-showcase__cta:after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 1px;
  background: {{ section.settings.text_color }};
}

@media screen and (max-width: 749px) {

  .custom-dual-showcase .page-width {
    padding-left: 16px;
    padding-right: 16px;
  }

  .custom-dual-showcase__grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .custom-dual-showcase__cta {
    font-size: {{ section.settings.mobile_font_size }}px;
  }
}
</style>

{% schema %}
{
  "name": "Custom Dual Showcase",
  "settings": [
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop Font Size",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile Font Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Showcase Item",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "CTA Text",
          "default": "New Arrivals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection/Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Dual Showcase",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}