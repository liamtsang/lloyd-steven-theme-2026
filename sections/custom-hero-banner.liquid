{% comment %}
  Custom Hero Banner Section
  Save as:
  sections/custom-hero-banner.liquid
{% endcomment %}

<section 
  class="custom-hero-banner"
  style="
    --heading-size: {{ section.settings.heading_size }}px;
    --button-size: {{ section.settings.button_size }}px;
    --heading-color: {{ section.settings.heading_color }};
    --button-color: {{ section.settings.button_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>

  <div class="custom-hero-banner__media">

    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'custom-hero-banner__video'
      }}

    {% elsif section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2500 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        class="custom-hero-banner__image"
        loading="lazy"
      >
    {% endif %}

    <div class="custom-hero-banner__overlay"></div>

  </div>

  <div class="custom-hero-banner__content custom-hero-banner__content--{{ section.settings.content_position }}">
    
    <div class="custom-hero-banner__inner">

      {% if section.settings.heading != blank %}
        <h2 class="custom-hero-banner__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="custom-hero-banner__button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

  </div>

</section>

<style>
.custom-hero-banner {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.custom-hero-banner__media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.custom-hero-banner__image,
.custom-hero-banner__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-hero-banner__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,var(--overlay-opacity));
  z-index: 1;
}

.custom-hero-banner__content {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: flex;
  padding: 60px;
  box-sizing: border-box;
}

/* LEFT */
.custom-hero-banner__content--left-left {
  justify-content: flex-start;
  align-items: flex-start;
  text-align: left;
}

.custom-hero-banner__content--left-center {
  justify-content: flex-start;
  align-items: center;
  text-align: left;
}

.custom-hero-banner__content--left-right {
  justify-content: flex-start;
  align-items: flex-end;
  text-align: left;
}

/* CENTER */
.custom-hero-banner__content--center-left {
  justify-content: center;
  align-items: flex-start;
  text-align: center;
}

.custom-hero-banner__content--center-center {
  justify-content: center;
  align-items: center;
  text-align: center;
}

.custom-hero-banner__content--center-right {
  justify-content: center;
  align-items: flex-end;
  text-align: center;
}

/* RIGHT */
.custom-hero-banner__content--right-left {
  justify-content: flex-end;
  align-items: flex-start;
  text-align: right;
}

.custom-hero-banner__content--right-center {
  justify-content: flex-end;
  align-items: center;
  text-align: right;
}

.custom-hero-banner__content--right-right {
  justify-content: flex-end;
  align-items: flex-end;
  text-align: right;
}

.custom-hero-banner__inner {
  max-width: 600px;
}

.custom-hero-banner__heading {
  margin: 0 0 20px;
  font-size: var(--heading-size);
  color: var(--heading-color);
  line-height: 1.1;
  font-family: serif;
  font-style: 'DaVinci';
  font-weight: 400;
}

.custom-hero-banner__button {
  display: inline-block;
  font-size: var(--button-size);
  color: var(--button-color);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
  transition: opacity 0.3s ease;
}

.custom-hero-banner__button:hover {
  opacity: 0.7;
}

@media screen and (max-width: 768px) {

  .custom-hero-banner {
    height: 80vh;
  }

  .custom-hero-banner__content {
    padding: 30px 20px;
  }

  .custom-hero-banner__heading {
    font-size: calc(var(--heading-size) * 0.65);
  }

  .custom-hero-banner__button {
    font-size: calc(var(--button-size) * 0.9);
  }

}
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [

    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },

    {
      "type": "video",
      "id": "video",
      "label": "Background Video"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Summer 2026"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },

    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "default": "left-center",
      "options": [
        {
          "value": "left-left",
          "label": "Left Left"
        },
        {
          "value": "left-center",
          "label": "Left Center"
        },
        {
          "value": "left-right",
          "label": "Left Right"
        },
        {
          "value": "center-left",
          "label": "Center Left"
        },
        {
          "value": "center-center",
          "label": "Center Center"
        },
        {
          "value": "center-right",
          "label": "Center Right"
        },
        {
          "value": "right-left",
          "label": "Right Left"
        },
        {
          "value": "right-center",
          "label": "Right Center"
        },
        {
          "value": "right-right",
          "label": "Right Right"
        }
      ]
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 58
    },

    {
      "type": "range",
      "id": "button_size",
      "label": "Button Font Size",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#ffffff"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 20
    }

  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}