<style>
.custom-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
}

.custom-split__item {
  position: relative;
  overflow: hidden;
  min-width: 0;
}

.custom-split__image img,
.custom-split__video video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* OVERLAY */
.custom-split__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
}

/* CONTENT */
.custom-split__content {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  padding: 40px;
  box-sizing: border-box;
}

.custom-split__content--left {
  justify-content: flex-start;
  align-items: center;
  text-align: left;
}

.custom-split__content--center {
  justify-content: center;
  align-items: center;
  text-align: center;
}

.custom-split__content--right {
  justify-content: flex-end;
  align-items: center;
  text-align: right;
}

.custom-split__inner {
  max-width: 500px;
}

.custom-split__heading {
  margin: 0 0 15px;
  font-size: {{ section.settings.heading_size }}px;
  font-family: 'TRJANDaVinci', serif !important;
  font-style: italic;
  line-height: 1.1;
}

.custom-split__button {
  display: inline-block;
  text-decoration: none;
  font-size: {{ section.settings.button_size }}px;
  font-family: 'TRJANDaVinci', serif !important;
  font-style: italic;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
  transition: opacity .3s ease;
}

.custom-split__button:hover {
  opacity: .7;
}

/* Desktop */
@media screen and (min-width: 990px) {
  .custom-split {
    height: 80vh;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {

  .custom-split {
    grid-template-columns: 1fr;
    height: auto;
  }

  .custom-split__item {
    min-height: 60vh;
  }

  .custom-split__content {
    padding: 25px;
  }

  .custom-split__heading {
    font-size: calc({{ section.settings.heading_size }}px * .7);
  }

}
</style>

<div class="custom-split">

{% if section.settings.layout == 'image_left' %}

  <!-- IMAGE -->
  <div class="custom-split__item custom-split__image">

    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
      >
    {% endif %}

    {% if section.settings.show_image_overlay %}
      <div 
        class="custom-split__overlay"
        style="background: rgba(0,0,0,{{ section.settings.image_overlay_opacity | divided_by: 100.0 }});"
      ></div>

      <div class="custom-split__content custom-split__content--{{ section.settings.image_content_position }}">
        <div class="custom-split__inner">

          {% if section.settings.image_heading != blank %}
            <h2 
              class="custom-split__heading"
              style="color: {{ section.settings.image_heading_color }};"
            >
              {{ section.settings.image_heading }}
            </h2>
          {% endif %}

          {% if section.settings.image_button_label != blank %}
            <a 
              href="{{ section.settings.image_button_link }}" 
              class="custom-split__button"
              style="color: {{ section.settings.image_button_color }};"
            >
              {{ section.settings.image_button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}

  </div>

  <!-- VIDEO -->
  <div class="custom-split__item custom-split__video">

    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          muted: true,
          loop: true,
          controls: false,
          playsinline: true
      }}

    {% elsif section.settings.video_url != blank %}
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}

    {% if section.settings.show_video_overlay %}
      <div 
        class="custom-split__overlay"
        style="background: rgba(0,0,0,{{ section.settings.video_overlay_opacity | divided_by: 100.0 }});"
      ></div>

      <div class="custom-split__content custom-split__content--{{ section.settings.video_content_position }}">
        <div class="custom-split__inner">

          {% if section.settings.video_heading != blank %}
            <h2 
              class="custom-split__heading"
              style="color: {{ section.settings.video_heading_color }};"
            >
              {{ section.settings.video_heading }}
            </h2>
          {% endif %}

          {% if section.settings.video_button_label != blank %}
            <a 
              href="{{ section.settings.video_button_link }}" 
              class="custom-split__button"
              style="color: {{ section.settings.video_button_color }};"
            >
              {{ section.settings.video_button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}

  </div>

{% else %}

  <!-- VIDEO -->
  <div class="custom-split__item custom-split__video">

    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          muted: true,
          loop: true,
          controls: false,
          playsinline: true
      }}

    {% elsif section.settings.video_url != blank %}
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}

    {% if section.settings.show_video_overlay %}
      <div 
        class="custom-split__overlay"
        style="background: rgba(0,0,0,{{ section.settings.video_overlay_opacity | divided_by: 100.0 }});"
      ></div>

      <div class="custom-split__content custom-split__content--{{ section.settings.video_content_position }}">
        <div class="custom-split__inner">

          {% if section.settings.video_heading != blank %}
            <h2 
              class="custom-split__heading"
              style="color: {{ section.settings.video_heading_color }};"
            >
              {{ section.settings.video_heading }}
            </h2>
          {% endif %}

          {% if section.settings.video_button_label != blank %}
            <a 
              href="{{ section.settings.video_button_link }}" 
              class="custom-split__button"
              style="color: {{ section.settings.video_button_color }};"
            >
              {{ section.settings.video_button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}

  </div>

  <!-- IMAGE -->
  <div class="custom-split__item custom-split__image">

    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
      >
    {% endif %}

    {% if section.settings.show_image_overlay %}
      <div 
        class="custom-split__overlay"
        style="background: rgba(0,0,0,{{ section.settings.image_overlay_opacity | divided_by: 100.0 }});"
      ></div>

      <div class="custom-split__content custom-split__content--{{ section.settings.image_content_position }}">
        <div class="custom-split__inner">

          {% if section.settings.image_heading != blank %}
            <h2 
              class="custom-split__heading"
              style="color: {{ section.settings.image_heading_color }};"
            >
              {{ section.settings.image_heading }}
            </h2>
          {% endif %}

          {% if section.settings.image_button_label != blank %}
            <a 
              href="{{ section.settings.image_button_link }}" 
              class="custom-split__button"
              style="color: {{ section.settings.image_button_color }};"
            >
              {{ section.settings.image_button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}

  </div>

{% endif %}

</div>

{% schema %}
{
  "name": "Image / Video Split",
  "settings": [

    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image Left / Video Right"
        },
        {
          "value": "video_left",
          "label": "Video Left / Image Right"
        }
      ]
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },

    {
      "type": "url",
      "id": "video_url",
      "label": "Fallback MP4 URL"
    },

    {
      "type": "checkbox",
      "id": "show_image_overlay",
      "label": "Show Image Overlay Content",
      "default": true
    },

    {
      "type": "text",
      "id": "image_heading",
      "label": "Image Heading"
    },

    {
      "type": "text",
      "id": "image_button_label",
      "label": "Image Button Label"
    },

    {
      "type": "url",
      "id": "image_button_link",
      "label": "Image Button Link"
    },

    {
      "type": "select",
      "id": "image_content_position",
      "label": "Image Content Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 20
    },

    {
      "type": "color",
      "id": "image_heading_color",
      "label": "Image Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "image_button_color",
      "label": "Image Button Color",
      "default": "#ffffff"
    },

    {
      "type": "checkbox",
      "id": "show_video_overlay",
      "label": "Show Video Overlay Content",
      "default": true
    },

    {
      "type": "text",
      "id": "video_heading",
      "label": "Video Heading"
    },

    {
      "type": "text",
      "id": "video_button_label",
      "label": "Video Button Label"
    },

    {
      "type": "url",
      "id": "video_button_link",
      "label": "Video Button Link"
    },

    {
      "type": "select",
      "id": "video_content_position",
      "label": "Video Content Position",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    {
      "type": "range",
      "id": "video_overlay_opacity",
      "label": "Video Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 20
    },

    {
      "type": "color",
      "id": "video_heading_color",
      "label": "Video Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "video_button_color",
      "label": "Video Button Color",
      "default": "#ffffff"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 54
    },

    {
      "type": "range",
      "id": "button_size",
      "label": "Button Size",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    }

  ],

  "presets": [
    {
      "name": "Image + Video Split"
    }
  ]
}
{% endschema %}