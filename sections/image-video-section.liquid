<style>
.custom-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0; /* cleaner, edge-to-edge like luxury brands */
  align-items: stretch;
}

/* Prevent shifting / overflow issues */
.custom-split > div {
  min-width: 0;
}

/* LEFT IMAGE */
.custom-split__image {
  height: 100%;
}

.custom-split__image img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 🔥 key for clean layout */
  display: block;
}

/* RIGHT VIDEO */
.custom-split__video {
  height: 100%;
}

.custom-split__video video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Optional: set a consistent section height */
@media screen and (min-width: 990px) {
  .custom-split {
    height: 80vh; /* adjust: 70–90vh depending on your taste */
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .custom-split {
    grid-template-columns: 1fr;
    height: auto;
  }

  .custom-split__image,
  .custom-split__video {
    height: auto;
  }
}
</style>

<div class="custom-split">

  <!-- LEFT: IMAGE -->
  <div class="custom-split__image">
    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 1500 }}" 
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
      >
    {% endif %}
  </div>

  <!-- RIGHT: VIDEO -->
  <div class="custom-split__video">
    {% if section.settings.video != blank %}
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>
    {% endif %}
  </div>

</div>

{% schema %}
{
  "name": "Image Left Video Right",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "url",
      "id": "video",
      "label": "Video URL (MP4)"
    }
  ],
  "presets": [
    {
      "name": "Image + Video Split"
    }
  ]
}
{% endschema %}