<style>
.custom-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
}

.custom-split > div {
  min-width: 0;
}

/* IMAGE */
.custom-split__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* VIDEO */
.custom-split__video video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Desktop height */
@media screen and (min-width: 990px) {
  .custom-split {
    height: 80vh;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .custom-split {
    grid-template-columns: 1fr;
    height: auto;
  }
}
</style>

<div class="custom-split">

  <!-- LEFT IMAGE -->
  <div class="custom-split__image">
    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 1600 }}" 
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
      >
    {% endif %}
  </div>

  <!-- RIGHT VIDEO -->
  <div class="custom-split__video">
    <video 
      autoplay 
      muted 
      loop 
      playsinline 
      preload="metadata"
    >
      <source src="https://cdn.shopify.com/videos/c/o/v/318f2106fa564dceaee05ba6dee84be3.mp4" type="video/mp4">
    </video>
  </div>

</div>

{% schema %}
{
  "name": "Image Left Video Right",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    }
  ],
  "presets": [
    {
      "name": "Image + Video Split"
    }
  ]
}
{% endschema %}