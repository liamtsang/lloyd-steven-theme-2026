<style>
.custom-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
}

.custom-split > div {
  min-width: 0;
}

/* IMAGE */
.custom-split__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* VIDEO */
.custom-split__video video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Desktop height */
@media screen and (min-width: 990px) {
  .custom-split {
    height: 80vh;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .custom-split {
    grid-template-columns: 1fr;
    height: auto;
  }
}
</style>

<div class="custom-split">

  <!-- LEFT IMAGE -->
  <div class="custom-split__image">
    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 1600 }}" 
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
      >
    {% endif %}
  </div>

  <!-- RIGHT VIDEO -->
  <div class="custom-split__video">

    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          muted: true,
          loop: true,
          controls: false
      }}

    {% elsif section.settings.video_url != blank %}
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}

  </div>

</div>

{% schema %}
{
  "name": "Image Left Video Right",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Upload in Shopify)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Fallback MP4 URL (optional)"
    }
  ],
  "presets": [
    {
      "name": "Image + Video Split"
    }
  ]
}
{% endschema %}