<style>
.custom-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
}

.custom-split__item {
  position: relative;
  overflow: hidden;
  min-width: 0;
}

.custom-split__item img,
.custom-split__item video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* OVERLAY */
.custom-split__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
}

/* CONTENT */
.custom-split__content {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  padding: 40px;
  box-sizing: border-box;
}

.custom-split__content--left {
  justify-content: flex-start;
  align-items: center;
  text-align: left;
}

.custom-split__content--center {
  justify-content: center;
  align-items: center;
  text-align: center;
}

.custom-split__content--right {
  justify-content: flex-end;
  align-items: center;
  text-align: right;
}

.custom-split__inner {
  max-width: 500px;
}

.custom-split__heading {
  margin: 0 0 15px;
  font-size: {{ section.settings.heading_size }}px;
  font-family: 'TRJANDaVinci', serif !important;
  font-style: italic;
  line-height: 1.1;
}

.custom-split__button {
  display: inline-block;
  text-decoration: none;
  font-size: {{ section.settings.button_size }}px;
  font-family: 'TRJANDaVinci', serif !important;
  font-style: italic;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
  transition: opacity .3s ease;
}

.custom-split__button:hover {
  opacity: .7;
}

/* Desktop */
@media screen and (min-width: 990px) {
  .custom-split {
    height: 80vh;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {

  .custom-split {
    grid-template-columns: 1fr;
    height: auto;
  }

  .custom-split__item {
    min-height: 60vh;
  }

  .custom-split__content {
    padding: 25px;
  }

  .custom-split__heading {
    font-size: calc({{ section.settings.heading_size }}px * .7);
  }

}
</style>

<div class="custom-split">

  <!-- LEFT -->
  <div class="custom-split__item">

    {% if section.settings.left_media_type == 'image' %}

      {% if section.settings.left_image != blank %}
        <img 
          src="{{ section.settings.left_image | image_url: width: 2200 }}"
          alt="{{ section.settings.left_image.alt | escape }}"
          loading="lazy"
        >
      {% endif %}

    {% else %}

      {% if section.settings.left_video != blank %}
        {{
          section.settings.left_video
          | video_tag:
            autoplay: true,
            muted: true,
            loop: true,
            controls: false,
            playsinline: true
        }}

      {% elsif section.settings.left_video_url != blank %}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.left_video_url }}" type="video/mp4">
        </video>
      {% endif %}

    {% endif %}

    {% if section.settings.show_left_overlay %}
      <div 
        class="custom-split__overlay"
        style="background: rgba(0,0,0,{{ section.settings.left_overlay_opacity | divided_by: 100.0 }});"
      ></div>

      <div class="custom-split__content custom-split__content--{{ section.settings.left_content_position }}">
        <div class="custom-split__inner">

          {% if section.settings.left_heading != blank %}
            <h2 
              class="custom-split__heading"
              style="color: {{ section.settings.left_heading_color }};"
            >
              {{ section.settings.left_heading }}
            </h2>
          {% endif %}

          {% if section.settings.left_button_label != blank %}
            <a 
              href="{{ section.settings.left_button_link }}"
              class="custom-split__button"
              style="color: {{ section.settings.left_button_color }};"
            >
              {{ section.settings.left_button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}

  </div>

  <!-- RIGHT -->
  <div class="custom-split__item">

    {% if section.settings.right_media_type == 'image' %}

      {% if section.settings.right_image != blank %}
        <img 
          src="{{ section.settings.right_image | image_url: width: 2200 }}"
          alt="{{ section.settings.right_image.alt | escape }}"
          loading="lazy"
        >
      {% endif %}

    {% else %}

      {% if section.settings.right_video != blank %}
        {{
          section.settings.right_video
          | video_tag:
            autoplay: true,
            muted: true,
            loop: true,
            controls: false,
            playsinline: true
        }}

      {% elsif section.settings.right_video_url != blank %}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.right_video_url }}" type="video/mp4">
        </video>
      {% endif %}

    {% endif %}

    {% if section.settings.show_right_overlay %}
      <div 
        class="custom-split__overlay"
        style="background: rgba(0,0,0,{{ section.settings.right_overlay_opacity | divided_by: 100.0 }});"
      ></div>

      <div class="custom-split__content custom-split__content--{{ section.settings.right_content_position }}">
        <div class="custom-split__inner">

          {% if section.settings.right_heading != blank %}
            <h2 
              class="custom-split__heading"
              style="color: {{ section.settings.right_heading_color }};"
            >
              {{ section.settings.right_heading }}
            </h2>
          {% endif %}

          {% if section.settings.right_button_label != blank %}
            <a 
              href="{{ section.settings.right_button_link }}"
              class="custom-split__button"
              style="color: {{ section.settings.right_button_color }};"
            >
              {{ section.settings.right_button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}

  </div>

</div>

{% schema %}
{
  "name": "Flexible Media Split",
  "settings": [

    {
      "type": "header",
      "content": "Left Media"
    },

    {
      "type": "select",
      "id": "left_media_type",
      "label": "Left Media Type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },

    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },

    {
      "type": "video",
      "id": "left_video",
      "label": "Left Video"
    },

    {
      "type": "url",
      "id": "left_video_url",
      "label": "Left Fallback MP4 URL"
    },

    {
      "type": "checkbox",
      "id": "show_left_overlay",
      "label": "Show Left Overlay Content",
      "default": true
    },

    {
      "type": "text",
      "id": "left_heading",
      "label": "Left Heading"
    },

    {
      "type": "text",
      "id": "left_button_label",
      "label": "Left Button Label"
    },

    {
      "type": "url",
      "id": "left_button_link",
      "label": "Left Button Link"
    },

    {
      "type": "select",
      "id": "left_content_position",
      "label": "Left Content Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "range",
      "id": "left_overlay_opacity",
      "label": "Left Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 20
    },

    {
      "type": "color",
      "id": "left_heading_color",
      "label": "Left Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "left_button_color",
      "label": "Left Button Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Right Media"
    },

    {
      "type": "select",
      "id": "right_media_type",
      "label": "Right Media Type",
      "default": "video",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },

    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },

    {
      "type": "video",
      "id": "right_video",
      "label": "Right Video"
    },

    {
      "type": "url",
      "id": "right_video_url",
      "label": "Right Fallback MP4 URL"
    },

    {
      "type": "checkbox",
      "id": "show_right_overlay",
      "label": "Show Right Overlay Content",
      "default": true
    },

    {
      "type": "text",
      "id": "right_heading",
      "label": "Right Heading"
    },

    {
      "type": "text",
      "id": "right_button_label",
      "label": "Right Button Label"
    },

    {
      "type": "url",
      "id": "right_button_link",
      "label": "Right Button Link"
    },

    {
      "type": "select",
      "id": "right_content_position",
      "label": "Right Content Position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "range",
      "id": "right_overlay_opacity",
      "label": "Right Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 20
    },

    {
      "type": "color",
      "id": "right_heading_color",
      "label": "Right Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "right_button_color",
      "label": "Right Button Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 54
    },

    {
      "type": "range",
      "id": "button_size",
      "label": "Button Size",
      "min": 10,
